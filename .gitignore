# Artlog .gitignore
# Build outputs and local configuration are never committed.
# See github-release-audit-report.md for the full audit.

# Gradle / Android build outputs
.gradle/
build/
app/build/
local.properties
*.apk
*.aab
*.ap_
*.dex

# Signing keys (debug.keystore is regenerated by manual-build/build.sh when missing)
*.jks
*.keystore

# Android Studio / IntelliJ
.idea/
*.iml
*.hprof

# Manual build toolchain: fetched artifacts and generated files
# (reproducible via manual-build/resolve_deps.py and resolve_processors.py)
manual-build/deps/
manual-build/pom-cache/
manual-build/processor/
manual-build/deps.json
manual-build/processor.json
manual-build/__pycache__/
manual-build/build/
manual-build/debug.keystore

# Python
__pycache__/
*.pyc

# User data, databases, caches, logs (never in the repository)
*.db
*.sqlite
*.sqlite-journal
*.zip
*.log
.DS_Store
