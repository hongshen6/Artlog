<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.artlog.app">

    <!-- Round 5: Global Inspiration fetches recommendations over the
         network (data layer only). Everything else stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Next iteration (stages 5-6): local music playback. Foreground
         service of type mediaPlayback for the MediaSessionService;
         POST_NOTIFICATIONS is requested at runtime the first time the
         music player is opened (denial only hides the notification,
         playback continues). READ_MEDIA_AUDIO is deliberately NOT
         requested: imports go through SAF (OpenDocument) + copy to the
         private directory, using the URI's temporary grant. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- P0 acceptance-fix round: system-level floating lyrics.
         SYSTEM_ALERT_WINDOW is a special permission: it is only ever
         granted by the user on the system settings page
         (Settings.ACTION_MANAGE_OVERLAY_PERMISSION); the app never
         requests it at launch and never bypasses the system flow.
         Declaring it here is a precondition — without the declaration
         the system settings page cannot grant it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ArtlogApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Artlog"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Artlog"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Artlog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Next iteration (stage 6): Media3 playback service. The
             notification is generated by Media3's default notification
             provider (title/artist from the track metadata). -->
        <service
            android:name=".playback.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- P0 acceptance-fix round: system-level floating lyrics.
             A plain started service (no foreground type, no
             intent-filter, not exported): it only owns the overlay
             window (WindowManager + TYPE_APPLICATION_OVERLAY) and
             reads the shared MusicPlaybackState; it holds no player
             of its own. START_STICKY so the system restarts it after
             a kill; MainActivity.onResume re-syncs it on return to
             the foreground. It stops itself when the switch is off
             or the overlay permission is revoked. -->
        <service
            android:name=".playback.ExternalLyricsService"
            android:exported="false" />
    </application>

</manifest>
